NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/secure_service_desk
CORS_ORIGINS=http://localhost:3001
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

JWT_ISSUER=secure-service-desk-api
JWT_AUDIENCE=secure-service-desk-client
JWT_KEY_ID=local-development-key
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_TTL_SECONDS=900

REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=service_desk_refresh
CSRF_COOKIE_NAME=service_desk_csrf
COOKIE_SECURE=false
MFA_ENCRYPTION_KEY_BASE64=

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

REDIS_URL=redis://localhost:6379
QUEUE_RECOVERY_INTERVAL_MS=60000
CACHE_TTL_SECONDS=30

# Optional one-time bootstrap. Configure these only in your untracked local .env.
ALLOW_ADMIN_BOOTSTRAP=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
