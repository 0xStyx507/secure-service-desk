NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/secure_service_desk
CORS_ORIGINS=http://localhost:3001
TRUST_PROXY_HOPS=0
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

JWT_ISSUER=secure-service-desk-api
JWT_AUDIENCE=secure-service-desk-client
JWT_KEY_ID=local-development-key
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
# Optional overlap ring: JSON array of {kid,publicKeyBase64,privateKeyBase64?}.
# Retired keys may omit privateKeyBase64; the active key must include it.
JWT_KEY_RING_JSON=
JWT_ACCESS_TTL_SECONDS=900

REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=service_desk_refresh
CSRF_COOKIE_NAME=service_desk_csrf
COOKIE_SECURE=false
MFA_ENCRYPTION_KEY_BASE64=

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

REDIS_URL=redis://localhost:6379
METRICS_ENABLED=false
METRICS_TOKEN=

# Optional AWS-compatible adapters. Point AWS_ENDPOINT_URL to external Floci in dev.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_SQS_QUEUE_URL=
AWS_CLOUDWATCH_NAMESPACE=SecureServiceDesk
QUEUE_RECOVERY_INTERVAL_MS=60000
CACHE_TTL_SECONDS=30
PDF_RETENTION_DAYS=30

# Optional local AWS-compatible laboratory. Start separately with compose.floci.yml.
FLOCI_ENABLED=false
FLOCI_ENDPOINT=http://localhost:4566
FLOCI_REGION=us-east-1
FLOCI_ACCESS_KEY_ID=test
FLOCI_SECRET_ACCESS_KEY=test
FLOCI_S3_BUCKET=secure-service-desk-local
FLOCI_SQS_OUTBOX_QUEUE=secure-service-desk-outbox
FLOCI_CLOUDWATCH_LOG_GROUP=/secure-service-desk/local

# Optional one-time bootstrap. Configure these only in your untracked local .env.
ALLOW_ADMIN_BOOTSTRAP=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
