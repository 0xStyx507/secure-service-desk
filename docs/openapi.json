    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "service_desk_refresh"
      },
      "csrfToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-csrf-token",
        "description": "Double-submit CSRF token returned by register or login."
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MfaLoginDto": {
        "type": "object",
        "properties": {
          "challengeToken": {
            "type": "string",
            "description": "Opaque one-time challenge returned by /auth/login."
          },
          "code": {
            "type": "string",
            "description": "Six-digit TOTP code.",
            "example": "123456"
          }
        },
        "required": [
          "challengeToken",
          "code"
        ]
      },
      "CreateTicketDto": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "example": "Cannot access the customer portal",
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "example": "The portal returns an unauthorized response after signing in.",
            "maxLength": 10000
          }
        },
        "required": [
          "subject",
          "description"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "UpdateTicketDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "description": "Current ticket version used for optimistic concurrency control.",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "WAITING_USER",
              "RESOLVED",
              "CLOSED"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "assigneeId": {
            "type": "object",
            "description": "MongoDB user ID. Send null to remove the assignee.",
            "nullable": true
          },
          "resolution": {
            "type": "string",
            "description": "Required when resolving a ticket.",
            "minLength": 5,
            "maxLength": 5000
          }
        },
        "required": [
          "version"
        ]
      },
      "CreateCommentDto": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string",
            "maxLength": 10000
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "INTERNAL"
            ],
            "default": "PUBLIC",
            "description": "INTERNAL comments require SUPPORT or ADMIN."
          }
        },
        "required": [
          "body"
        ]
      },
      "CreateTicketReportDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "WAITING_USER",
              "RESOLVED",
              "CLOSED"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "maxRows": {
            "type": "object",
            "default": 500,
            "minimum": 1,
            "maximum": 2000
          }
        }
      },
      "UpdateUserRolesDto": {
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "ADMIN",
                "SUPPORT",
                "USER"
              ]
            }
          }
        },
        "required": [
          "roles"
        ]
      },
      "MfaCodeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Six-digit TOTP code.",
            "example": "123456"
          }
        },
        "required": [
          "code"
        ]
      },
      "DisableMfaDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "description": "Current account password."
          },
          "code": {
            "type": "string",
            "description": "Current six-digit TOTP code.",
            "example": "123456"
          }
        },
        "required": [
          "password",
          "code"
        ]
      }
    }
  }
}
