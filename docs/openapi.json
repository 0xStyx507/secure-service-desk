    },
    {
      "name": "auth",
      "description": "Code-managed authentication and sessions"
    },
    {
      "name": "tickets",
      "description": "Service desk tickets and comments"
    },
    {
      "name": "notifications",
      "description": "Persistent in-app notifications"
    },
    {
      "name": "attachments",
      "description": "Authorized ticket images stored in MongoDB GridFS"
    },
    {
      "name": "reports",
      "description": "Asynchronous PDF reports"
    },
    {
      "name": "governance",
      "description": "Administrator roles and audit trail"
    }
  ],
