{
  "name": "secure-service-desk-api",
  "version": "0.1.0",
  "private": true,
  "description": "Secure, modular service desk API built with NestJS, TypeScript and MongoDB.",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "11.8.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker:dev": "nest start --entryFile worker --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "openapi:export": "node dist/openapi-export.js",
    "web:dev": "pnpm --dir apps/web dev",
    "web:build": "pnpm --dir apps/web build",
    "web:lint": "pnpm --dir apps/web lint",
    "web:test": "pnpm --dir apps/web test",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"apps/web/**/*.{ts,tsx}\" \"apps/web/vite.config.ts\" eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"apps/web/**/*.{ts,tsx}\" \"apps/web/vite.config.ts\" \"*.{json,yml,yaml,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"apps/web/**/*.{ts,tsx}\" \"apps/web/vite.config.ts\" \"*.{json,yml,yaml,mjs}\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:integration": "pnpm run build && jest --config ./test/jest-integration.json --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1110.0",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/client-secrets-manager": "^3.1110.0",
    "@aws-sdk/client-sqs": "^3.1110.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "mongoose": "^8.18.2",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.2.1",
    "@testcontainers/mongodb": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jest": "^30.4.2",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.67.0"
  }
}
